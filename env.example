# Google Sheets Configuration
GOOGLE_SHEET_ID=your-google-sheet-id-here
GOOGLE_APPLICATION_CREDENTIALS=./rpc-node/cred/service-account.json
# OR use inline credentials:
# GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# RPC Node Configuration
CHAIN_ID=12345
NETWORK_NAME=SheetChain
LOG_LEVEL=info
PORT=8545

# Bridge Account Configuration (for RPC Node)
BRIDGE_ACCOUNT_PRIVATE_KEY=0xYourPrivateKeyHere
BRIDGE_OPERATOR_ADDRESS=0x337d7730a281efE851dbEDf5F4eD0D2610E59639

# Bridge Backend Configuration
SHEET_RPC_URL=http://rpc-node:8545
SHEET_PRIVATE_KEY=0xYourSheetChainPrivateKeyHere
BSC_PRIVATE_KEY=0xYourBSCPrivateKeyHere

# Solana Configuration (Optional)
SOLANA_SECRET_KEY=["your","solana","secret","key","array"]
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_PROGRAM_ID=46BKi3nxgwFpc8EXE2Yem3syK5yqQRvJLasWzvsTEEgx
SOLANA_TOKEN_MINT=4opADvbtoEaXryZH5UoEpVXERDJoRMZoXy8yMsogsc2S

# Bridge Polling Configuration
# Default: 30000 (30 seconds) - increased to reduce Google Sheets API quota usage
# The monitor will automatically back off if quota errors occur
BRIDGE_POLL_INTERVAL_MS=30000

# Optional: Token Minting Configuration (for RPC Node)
RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
TOKEN_CONTRACT_ADDRESS=0x5e030a6f6218ada6b29eb46b5344386ea9765702
MINTER_PRIVATE_KEY=0xYourMinterPrivateKeyHere

# Credentials Path (for Docker volumes)
GOOGLE_CREDENTIALS_PATH=./rpc-node/cred
